{
  "name": "flowmap",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "flowmap": "./bin/flowmap.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:cli && pnpm build:ui",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" --packages=external && chmod +x dist/cli.js",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "pnpm build && playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "elkjs": "^0.12.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "flowmap": "link:.",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
